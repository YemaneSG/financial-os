{
  "name": "financial-os",
  "version": "0.1.0",
  "private": true,
  "description": "Financial OS — root workspace",
  "packageManager": "pnpm@11.19.0",
  "workspaces": [
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "pnpm --filter @financial-os/web dev",
    "build": "pnpm --filter @financial-os/web build",
    "test": "pnpm --filter @financial-os/web test",
    "test:e2e": "pnpm --filter @financial-os/web test:e2e",
    "lint": "pnpm --filter @financial-os/web lint",
    "type-check": "pnpm --filter @financial-os/web type-check",
    "mobile:dev": "pnpm --filter financial-os-mobile start",
    "mobile:build": "pnpm --filter financial-os-mobile build",
    "mobile:test": "pnpm --filter financial-os-mobile test",
    "mobile:lint": "pnpm --filter financial-os-mobile lint",
    "mobile:type-check": "pnpm --filter financial-os-mobile type-check"
  },
  "devDependencies": {
    "typescript": "~5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  }
}
