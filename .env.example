# Financial OS — environment variable contract
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file with real values.
# All secrets in production come from Secret Manager; this file is for local dev only.

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Values: development | staging | production
LOG_LEVEL=INFO

# ── GCP project (local dev / emulator) ───────────────────────────────────────
# Use a personal dev project ID — never the production project ID in local .env
GCP_PROJECT_ID=your-dev-gcp-project-id
GCP_REGION=us-central1

# ── Firebase ──────────────────────────────────────────────────────────────────
# Firebase project for authentication (can match GCP project or be separate)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to Firebase service-account JSON for local dev only (never commit the JSON)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/local-dev-service-account.json

# ── Database (Cloud SQL / local Postgres) ────────────────────────────────────
# For local development use a local Postgres connection string.
# In production, use the Cloud SQL connector via IAM auth — no password.
DATABASE_URL=postgresql+asyncpg://financialos:changeme@localhost:5432/financialos_dev
# Cloud SQL instance connection name (production / staging only)
# Format: PROJECT:REGION:INSTANCE
CLOUD_SQL_INSTANCE_CONNECTION_NAME=

# ── Evidence storage ──────────────────────────────────────────────────────────
# Private GCS bucket name for receipt evidence
GCS_EVIDENCE_BUCKET=your-dev-evidence-bucket
# Signed-URL lifetime in seconds (default 900 = 15 minutes)
SIGNED_URL_LIFETIME_SECONDS=900

# ── Cloud Tasks ──────────────────────────────────────────────────────────────
CLOUD_TASKS_QUEUE_NAME=receipt-processing
CLOUD_TASKS_LOCATION=us-central1
# Full resource name of the queue: projects/PROJECT/locations/LOCATION/queues/NAME
CLOUD_TASKS_QUEUE_PATH=
# URL of the worker service that Cloud Tasks delivers to
CLOUD_TASKS_WORKER_URL=http://localhost:8001/internal/v1/receipts/{receipt_id}/process
# Service account email that Cloud Tasks uses to sign OIDC tokens for worker invocation
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=

# ── Worker ────────────────────────────────────────────────────────────────────
# OIDC audience the worker validates on incoming Cloud Tasks requests
WORKER_OIDC_AUDIENCE=http://localhost:8001
# Maximum concurrent extraction goroutines/threads in the worker
WORKER_MAX_CONCURRENT_EXTRACTIONS=4

# ── Extraction provider (Vertex AI) ──────────────────────────────────────────
# Provider adapter class path (supports future provider swap)
EXTRACTION_PROVIDER=financial_os.adapters.extraction.vertex.VertexExtractionAdapter
# Vertex AI Gemini model ID (exact model, recorded per run)
VERTEX_MODEL_ID=gemini-2.0-flash-001
# Vertex AI endpoint location
VERTEX_LOCATION=us-central1
# Extraction prompt version (must match schema version)
EXTRACTION_PROMPT_VERSION=v1
# Extraction schema version (must match prompt version)
EXTRACTION_SCHEMA_VERSION=v1

# ── Worker input ceilings (see implementation-contracts.md) ──────────────────
WORKER_MAX_ASSETS_PER_EXTRACTION=10
WORKER_MAX_ASSET_BYTES=10485760
WORKER_MAX_TOTAL_EXTRACTION_BYTES=52428800
# Terminal cost circuit breaker: max estimated provider cost per extraction in USD cents
WORKER_MAX_EXTRACTION_COST_CENTS=50

# ── Auth / allowlist ──────────────────────────────────────────────────────────
# Comma-separated list of allowlisted Firebase/Google provider subject IDs (not emails)
# Format: google:<subject_id>
OWNER_ALLOWLIST=google:your-google-subject-id
# Session version: increment to invalidate all existing sessions
SESSION_VERSION=1

# ── Security ──────────────────────────────────────────────────────────────────
# CORS allowed origin — must match the deployed Firebase Hosting URL
CORS_ALLOWED_ORIGIN=http://localhost:5173
# Maximum receipt image size in bytes (enforced server-side; client does advisory check)
MAX_IMAGE_BYTE_SIZE=10485760
# Maximum assets per receipt (enforced at create time)
MAX_ASSETS_PER_RECEIPT=10
# Request rate limit (requests per minute per owner)
RATE_LIMIT_RPM=60

# ── Reconciliation scheduler ─────────────────────────────────────────────────
# Age thresholds for the stale-work reconciliation sweep (seconds)
RECONCILE_UPLOADING_STALE_SECONDS=1800
RECONCILE_QUEUED_STALE_SECONDS=600
RECONCILE_PROCESSING_STALE_SECONDS=300

# ── Observability ─────────────────────────────────────────────────────────────
# Service name written to all structured log events
SERVICE_NAME=financial-os-api
# Pipeline version tag written to extraction run records
PIPELINE_VERSION=local-dev
